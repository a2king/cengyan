# Optional Java configuration for this deployment package.
# Uncomment and change this line when Java 21 is not in the system PATH.
# The export form is required; do not write `export $JAVA_HOME=...`.
# export JAVA_HOME=/opt/jdk-21
#
# Examples:
# export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# export JAVA_HOME=/data/runtime/jdk-21
#
# If a newer libstdc++.so.6 is installed outside the system path, configure it
# here so RocksDB can load its native library:
# export LD_LIBRARY_PATH=/opt/rh/gcc-toolset-11/root/usr/lib64:${LD_LIBRARY_PATH:-}
