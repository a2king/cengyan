# Optional Java configuration for Studio.
# Studio uses Java 21 from JAVA_HOME or PATH; when neither is Java 21 it unpacks
# the JDK shipped in jdk/ into runtime/jdk and uses that.
# The export form is required; do not write `export $JAVA_HOME=...`.
# export JAVA_HOME=/opt/jdk-21
#
# Examples:
# export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# export JAVA_HOME=/data/runtime/jdk-21
#
# Storage/Compute run on managed servers with the bundled JDK; their JVM options
# are edited on the Studio configuration page, not here.
