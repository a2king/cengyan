<?xml version="1.0" encoding="UTF-8"?>
<!-- Storage / Compute use this external configuration via their launch script.
     Daemon stdout/stderr still go to logs/<role>-<node_id>.log.
     Change root or individual logger levels below; Logback reloads within 30s.
     This console-only configuration does NOT rotate redirected stdout files. -->
<configuration scan="true" scanPeriod="30 seconds">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%date %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.cengyan" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.apache.ratis" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
